{
  "name": "netops-hub-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker & D1 Backend for NetOps Hub",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute netops-hub-d1 --file=./schema.sql",
    "d1:seed": "wrangler d1 execute netops-hub-d1 --file=./migrations/0001_initial.sql"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
